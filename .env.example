# --- Supabase (public values only) -------------------------------------------
# Project URL and the *publishable* (anon) key from Supabase → Project Settings → API.
# NEVER put the service_role / secret key in a VITE_ variable: the build refuses it.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Canonical public URL of the site, without trailing slash. Used for canonical
# links, Open Graph, sitemap.xml and robots.txt.
VITE_SITE_URL=https://www.example.mk

# --- Advertising (optional) -----------------------------------------------------
# Leave empty until the AdSense account is approved. Ads are only loaded after a
# visitor gives advertising consent. Slot IDs come from the AdSense dashboard.
VITE_ADSENSE_CLIENT=
VITE_AD_SLOT_HOME=
VITE_AD_SLOT_DIRECTORY=
VITE_AD_SLOT_TOOL=
VITE_AD_SLOT_ARTICLE=
VITE_AD_SLOT_COMPARISON=
